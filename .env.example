# Supabase (browser-safe values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the site. QR codes and email links use it. Required on Vercel.
NEXT_PUBLIC_SITE_URL=

# Server only. Never expose these to the browser or commit them.
SUPABASE_SERVICE_ROLE_KEY=

# Payments. Leave FINANCIAL_PROVIDER empty to keep digital payments switched off.
# mock = test provider (no real money). Ecobank providers arrive with the Ecobank milestone.
FINANCIAL_PROVIDER=
# Random secret of at least 24 characters used to sign and verify provider webhooks.
PAYMENT_WEBHOOK_SECRET=
# Required to run the mock provider on a Vercel production deployment (test deployments only).
ALLOW_MOCK_PAYMENTS=
